import React, { createContext, useState, useEffect, useMemo } from 'react';
import axios from 'axios';
import axiosInstance from 'Services/AxiosInstane';
// Create context with a default value
export const RbacContext = createContext({
  roles: [],
  components: [],
  navigation: [],
  hasAccess: () => false,
  hasRole: () => false,
  loading: true,
  error: null
});

// Define the base navigation structure with exact component names matching the API
const baseNavigation = [
  {
    name: "Dashboard",
    href: "/",
    componentKey: "Dashboard",
    submenus: [
      { name: "Overview", href: "/", componentKey: "Overview" },
      { name: "Hosts", href: "/hosts", componentKey: "Hosts" },
      { name: "Data Stores", href: "/data-stores", componentKey: "Data Stores" },
      { name: "VMS", href: "/vms", componentKey: "VMS" },
    ],
  },
  { 
    name: "Reports", 
    href: "/", 
    componentKey: "Reports",
    submenus: [
      { name: "Template", href: "/template", componentKey: "Template" },
      { name: "Horizon Reports", href: "/reports", componentKey: "Horizon Reports" },
      {name:"Vamanit Dass Reports", href: "/vamanitreports", componentKey: "Vamanit Dass Reports"}
    ]
  },
  { 
    name: "Schedule", 
    href: "/Reportlist", 
    componentKey: "Schedule" 
  },
  { 
    name: "Pools", 
    href: "/pools", 
    componentKey: "Pools" 
  },
  { 
    name: "Tasks", 
    href: "/tasks", 
    componentKey: "Tasks" 
  },
  {
    name: "Settings",
    href: "/",
    componentKey: "Settings",
    submenus: [
      { name: "TOTP", href: "/totp", current: false, beta: true ,componentKey:"TOTP"},
      { name: "Domain", href: "/domain", current: false, beta: false, componentKey:"Domain" },
      { name: "Cluster", href: "/clusters", current: false, beta: false , componentKey:"Cluster"},
      // { name: "Vsphere Monitoring", href: "/vsphere-monitoring", current: false, beta: false },
      { name: "SSL", href: "/ssl", current: false, beta: true, componentKey:"SSL" },
      {name : "SMTP", href: "/SmtpConfig", current:false, beta: false, componentKey:"SMTP"},
      {name: "RBAC", href: "/user_management", current: false , componentKey:"RBAC"}
    ],
  },
];

const RbacProvider = ({ children, tokenParsed ,token}) => {
  const [roles, setRoles] = useState([]);
  const [components, setComponents] = useState([]);
  const [navigation, setNavigation] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const username = tokenParsed?.preferred_username;
  
  const filterNavigation = (navItems, allowedComponents) => {
    // console.log("Allowed components:", allowedComponents);
  
    // Iterate through each navigation item
    return navItems
      .filter(item => {
        // Check if the main item is accessible based on the allowed components
        const isMainItemAccessible = allowedComponents.includes(item.componentKey);
  
        // Check if any submenu is accessible
        const hasAccessibleSubmenus = item.submenus?.some(
          submenu => allowedComponents.includes(submenu.componentKey)
        );
  
        // Log each item and its accessibility
        // console.log(`Checking item: ${item.name}`, {
        //   isMainItemAccessible,
        //   hasAccessibleSubmenus,
        //   allowedComponents,
        // });
  
        // Return the item if either the main item or a submenu is accessible
        return isMainItemAccessible || hasAccessibleSubmenus;
      })
      .map(item => {
        // Make a copy of the item to modify
        const filteredItem = { ...item };
  
        // If the item has submenus, filter them
        if (item.submenus) {
          filteredItem.submenus = item.submenus.filter(
            submenu =>
              allowedComponents.includes(submenu.componentKey) || // Submenu itself is allowed
              allowedComponents.includes(item.componentKey) // Parent item is allowed
          );
        }
  
        // Return the modified item
        return filteredItem;
      })
      .filter(item => item.submenus?.length > 0 || !item.submenus); // Remove items with empty submenus
  };
  
  // Fetch RBAC permissions
  const getRoles = async () => {
    try {
      setLoading(true);
      setError(null);
     
      const response = await axiosInstance.get(
        `${process.env.REACT_APP_BACKEND_URL}/v1/guacamole/get_user_permissions/${username}`,
        {
          headers: {
            Authorization: `Bearer ${token}`,
          }
        }
       
      );
     
      
      // Handle the specific response format
      const { roles: userRoles, components: userComponents, status, code } = response.data;
      // console.log(response.data);
      if (code === 200 && status === 'Ok') {
        setRoles(userRoles || []);
        setComponents(userComponents || []);

        // Filter navigation based on user's component permissions
        const filteredNavigation = filterNavigation(baseNavigation, userComponents);
        setNavigation(filteredNavigation);
      } else {
        throw new Error('Invalid response from server');
      }
    } catch (error) {
      console.error('Failed to fetch RBAC permissions:', error);
      setError('Failed to load permissions. Please try again later.');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (username) {
      getRoles();
    }
  }, [username,token]);

  // Memoized context value
  const contextValue = useMemo(() => ({
    roles,
    components,
    navigation,
    loading,
    error,
    hasAccess: (componentName) => components.includes(componentName),
    hasRole: (roleName) => roles.includes(roleName),
    refreshPermissions: getRoles
  }), [roles, components, navigation, loading, error]);
  // console.log(contextValue,"contextValue")

  return (
    <RbacContext.Provider value={contextValue}>
      {children}
    </RbacContext.Provider>
  );
};

// Custom hook for consuming RBAC context
export const useRbac = () => {
  const context = React.useContext(RbacContext);
  if (context === undefined) {
    throw new Error('useRbac must be used within a RbacProvider');
  }
  return context;
};

export default RbacProvider;
